# Comments must be on their own line, never after a value.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret

# Free option: Google Gemini via an OpenAI-compatible endpoint (key from https://aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-gemini-key
LLM_MODEL=gemini-2.5-flash-lite

# Optional: use the Anthropic API instead (remove the three LLM_ lines above)
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_MODEL=claude-sonnet-5-5

# On Render use https://your-service.onrender.com
BASE_URL=http://localhost:3000
